<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>EQ Anatomy Lab 2 v1 @VERSION@</title>
    <organization>com.jpk</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>

    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="au" title="Audio Unit (Logic / GarageBand / Live)" description="/Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.jpk.eqanatomylab2v1.au"/>
    </choice>
    <choice id="vst3" title="VST3 (Live / Cubase / Studio One など)" description="/Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.jpk.eqanatomylab2v1.vst3"/>
    </choice>
    <choice id="app" title="Standalone（DAWなしで試せるアプリ）" description="/Applications">
        <pkg-ref id="com.jpk.eqanatomylab2v1.app"/>
    </choice>

    <pkg-ref id="com.jpk.eqanatomylab2v1.au"   version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.jpk.eqanatomylab2v1.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.jpk.eqanatomylab2v1.app"  version="@VERSION@">app.pkg</pkg-ref>
</installer-gui-script>
